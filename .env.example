# DoorDash MCP Server Configuration
# Copy this file to .env and fill in your values

# Claude API (for self-healing pattern detection)
ANTHROPIC_API_KEY=sk-ant-...

# DoorDash Credentials
DOORDASH_EMAIL=your-email@example.com
DOORDASH_PASSWORD=your-password

# Beeper (for order notifications)
BEEPER_CHAT_ID=!your-chat-id:beeper.com

# Craft (for state persistence)
CRAFT_SPACE_ID=your-space-id
CRAFT_API_KEY=your-api-key
CRAFT_STATE_DOC_ID=your-state-doc-id
CRAFT_PATTERN_DOC_ID=your-pattern-doc-id
CRAFT_ERROR_LOG_DOC_ID=your-error-log-doc-id

# Server Configuration
PORT=3000
NODE_ENV=development

# Test Mode (set to 'true' to prevent actual order placement)
TEST_MODE=true
